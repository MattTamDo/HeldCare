# Gemini — optional. Without a key the assessment falls back to an on-device
# parser, so the demo still works end to end.
# Put the real key in .env.local — never commit it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# Vitals provider. This build always simulates the contactless measurement.
NEXT_PUBLIC_PRESAGE_MODE=mock
