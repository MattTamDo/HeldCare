# Gemini — optional. Without a key the assessment falls back to an on-device
# parser, so the demo still works end to end.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Vitals provider. "mock" runs the simulated measurement (default, used for the
# demo). "live" selects the Presage adapter, which is a stub in this build.
NEXT_PUBLIC_PRESAGE_MODE=mock
