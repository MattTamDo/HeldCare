# Gemini — optional. Without a key the assessment falls back to an on-device
# parser, so the demo still works end to end.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Vitals provider. "mock" runs the simulated browser measurement. Real
# SmartSpectra Node/native metrics should be fed into the app through
# `npm run presage:camera-bridge` or the native iOS/Expo bridge.
NEXT_PUBLIC_PRESAGE_MODE=mock

# SmartSpectra / Presage — server-side only; never expose this as NEXT_PUBLIC.
SMARTSPECTRA_API_KEY=
SMARTSPECTRA_LOG_LEVEL=warning
SMARTSPECTRA_ENABLE_TELEMETRY=1
SMARTSPECTRA_FACE_METRICS=0
SMARTSPECTRA_CAMERA_INDEX=0
SMARTSPECTRA_CAMERA_WIDTH=1280
SMARTSPECTRA_CAMERA_HEIGHT=720
SMARTSPECTRA_CAMERA_FPS=30

# Local SmartSpectra Node camera bridge. Start the Next app first, then run:
# SMARTSPECTRA_BRIDGE_SESSION_ID=mac-camera npm run presage:camera-bridge
SMARTSPECTRA_BRIDGE_PLATFORM_URL=http://localhost:3000
SMARTSPECTRA_BRIDGE_SESSION_ID=mac-camera
SMARTSPECTRA_BRIDGE_DURATION_MS=0

# Electron shell for the native SmartSpectra renderer SDK. Start Next first,
# then run `npm run electron:dev`.
ELECTRON_START_URL=http://localhost:3000/responder/incident/incident-demo-001/assessment
ELECTRON_DEVTOOLS=0

# LiveKit iPhone camera transport. LIVEKIT_URL should be wss://...
# PHONE_CAMERA_TRANSPORT=auto uses LiveKit when configured; use local to avoid
# LiveKit/STUN/TURN DNS during local Electron SmartSpectra testing.
PHONE_CAMERA_TRANSPORT=auto
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_ACCESS_CODE=

# Optional public HTTPS origin for generated iPhone links. For a quick
# Cloudflare Tunnel, run `cloudflared tunnel --url http://localhost:3000` and
# paste the generated https://*.trycloudflare.com URL here.
CLOUDFLARE_TUNNEL_URL=
EXPO_PUBLIC_SMARTSPECTRA_API_KEY=
EXPO_PUBLIC_CAREFALL_PLATFORM_URL=
EXPO_PUBLIC_CAREFALL_SESSION_ID=
NEXT_PUBLIC_PHONE_BASE_URL=
